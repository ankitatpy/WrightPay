# Environment mode: local | test | staging | production
TEST_ENV=local

# Application URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1

# Test Execution Settings
HEADLESS=true
TEST_TIMEOUT=30000
TEST_RETRIES=0

# Database Connection (Safe example defaults - do not commit real secrets or production credentials)
DATABASE_URL=postgresql://postgres:password@localhost:5432/wrightpay

# Redis Connection (Safe example defaults - do not commit real secrets or production credentials)
REDIS_URL=redis://localhost:6379
