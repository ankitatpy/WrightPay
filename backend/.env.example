PORT=3001
NODE_ENV=production

# PostgreSQL Database (Supports standard URL or cloud SSL with ?sslmode=require)
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_SSL=false

# Redis (Supports standard redis:// or TLS rediss:// for cloud Redis)
REDIS_URL=redis://<user>:<password>@<host>:<port>
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-random-production-jwt-secret-at-least-64-characters
JWT_EXPIRES_IN=1d

# Frontend CORS Origin (e.g., https://wrightpay.vercel.app)
FRONTEND_URL=

# Idempotency Configuration
IDEMPOTENCY_TTL_SECONDS=86400

