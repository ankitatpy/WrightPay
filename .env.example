# WrightPay Environment Configuration Template
#
# Copy this file to .env.local in the frontend/ and backend/ directories.
# Do NOT commit this file with real credentials or secrets.
# Each application (frontend and backend) has its own .env.local file.

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
# Place these in: frontend/.env.local

# API Configuration
# NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Authentication (Supabase - Planned)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Other Frontend Configuration
# NEXT_PUBLIC_APP_ENV=development


# ============================================================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================================================
# Place these in: backend/.env.local

# Application
# NODE_ENV=development
# PORT=3001

# Database (Supabase PostgreSQL - Planned)
# DATABASE_URL=postgresql://user:password@host:port/database

# Authentication (Supabase - Planned)
# SUPABASE_PROJECT_URL=your_supabase_project_url
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis Configuration (Planned)
# REDIS_URL=redis://localhost:6379

# JWT Configuration (Planned)
# JWT_SECRET=your_jwt_secret_key
# JWT_EXPIRES_IN=24h

# Other Backend Configuration
# LOG_LEVEL=debug
# CORS_ORIGIN=http://localhost:3000
